# Copy to backend/.env and restrict access to the service account.
DATA_DIR=
NETWORK_INTERFACE=eth0
GATEWAY_IP=
NETWORK_SUBNET=

API_HOST=127.0.0.1
API_PORT=8080
AUTH_USERNAME=admin
# Optional bootstrap when no saved credential exists. Otherwise use --reset-password.
# Keep bcrypt dollar signs unchanged; normal startup requires a saved or bootstrap credential.
AUTH_PASSWORD_HASH=
ALLOWED_ORIGINS=
HTTPS_CERT_FILE=
HTTPS_KEY_FILE=
ALLOW_INSECURE_DEVELOPMENT=false
TRUSTED_PROXY_IPS=

ARP_SPOOF_INTERVAL=2
DEVICE_SCAN_INTERVAL=30
INSPECTION_BUDGET_BYTES=65536
INSPECTION_DEADLINE_SECONDS=5
MAX_UNDECIDED_FLOWS=1024
EVENT_QUEUE_CAPACITY=10000
EVENT_BATCH_SIZE=100
EVENT_FLUSH_SECONDS=1
ACCOUNTING_INTERVAL_SECONDS=5
RECONCILIATION_INTERVAL_SECONDS=30
TELEMETRY_RETENTION_DAYS=30
RETENTION_PRUNE_INTERVAL_SECONDS=3600
APP_SIGNATURES_FILE=
LOG_LEVEL=INFO
# Production assets default to backend/static. Relative paths use this file's directory.
STATIC_DIR=static
# Set true only for an intentionally API-only development server.
API_ONLY=false
