[Unit]
Description=Parental Control Network Manager
Documentation=https://github.com/your-repo/parental-control
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root

# Working directory - adjust to your installation path
WorkingDirectory=/opt/parental-control/backend

# Python virtual environment
Environment=PATH=/opt/parental-control/backend/venv/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1

# Main executable
ExecStart=/opt/parental-control/backend/venv/bin/python main.py

# Restart policy
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=3

# Graceful shutdown timeout
TimeoutStopSec=30

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=parental-control

# Security settings (relaxed because we need raw socket access)
NoNewPrivileges=false
ProtectSystem=false
ProtectHome=false

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

# Network capabilities
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
